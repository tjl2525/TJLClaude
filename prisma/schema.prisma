// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// BOARDS & COLUMNS (Trello-like structure)
// ============================================

model Board {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#3B82F6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  columns     Column[]
}

model Column {
  id       String @id @default(cuid())
  name     String
  position Int
  color    String @default("#6B7280")
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@index([boardId])
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String?
  position    Int
  priority    String    @default("medium") // low, medium, high, urgent
  dueDate     DateTime?
  value       Float?    // monetary value for deals
  columnId    String
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  labels      Label[]
  activities  Activity[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([columnId])
  @@index([contactId])
}

// ============================================
// CRM DATA
// ============================================

model Contact {
  id         String     @id @default(cuid())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  company    String?
  jobTitle   String?
  notes      String?
  status     String     @default("active") // active, inactive, lead
  cards      Card[]
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Label {
  id    String @id @default(cuid())
  name  String
  color String @default("#3B82F6")
  cards Card[]
}

model Activity {
  id        String   @id @default(cuid())
  type      String   // note, call, email, meeting, task
  content   String
  cardId    String?
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([cardId])
  @@index([contactId])
}

// ============================================
// FORMATION TRAINER
// ============================================

model Formation {
  id        String   @id @default(cuid())
  name      String   // correct name of the formation
  imageUrl  String   // path to the image file
  category  String?  // e.g. "Offense", "Defense", "Special Teams"
  notes     String?  // optional coach notes / hints
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
